# Generated output: rebuild it, don't commit it
print/out/
slides/out/
playbook/
kit/
tools/review/ocr
**/__pycache__/
*.pyc
.DS_Store

node_modules/

# Event data: photos, transcriptions and anything with names stays on your machine
runs/
data/session.json
inbox/

# Test material made or fetched on demand
tests/hw/fonts/
tests/hw/inbox/
tests/hw/truth.json
tests/hw/round3/
tests/fixtures/inbox/
tests/fixtures/fonts/

# Your own brand files (examples/can/brand holds only a README)
examples/can/brand/*.svg

# Golden test: pictures are per machine, built files are scratch
tests/golden/local/
tests/golden/work/

# Events set up with tools/new_event.py: your settings, kept out of the repo
events/

# Format handwriting tests: photos and answer keys are made on demand
tests/hw/*/inbox/
tests/hw/*/truth.json
tests/hw/*/PROFILE.md
