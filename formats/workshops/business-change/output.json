    ],
    "key": "person-{src}"
   }
  },
  {
   "path": "readiness[]",
   "label": "readiness {n}",
   "section": "Readiness",
   "policy": "trace",
   "match": [
    "score"
   ],
   "review": {
    "fields": [
     "because"
    ],
    "key": "ready-{src}"
   }
  },
  {
   "path": "risks[]",
